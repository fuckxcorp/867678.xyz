---
import MarkdownPage from "../components/MarkdownPage.astro";
import { getEntry, render } from "astro:content";

const home = await getEntry("home", "home");
if (!home) throw new Error("home entry not found");
const { Content, headings } = await render(home);
---

<MarkdownPage title="Home" headings={headings}>
  <Content />
</MarkdownPage>
