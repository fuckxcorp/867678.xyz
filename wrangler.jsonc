{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuckxter-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "FUCKXTER_ORIGINS": "http://localhost:4321,https://867678.xyz,https://www.867678.xyz,https://*.867678.pages.dev",
  },
  "routes": [
    {
      "pattern": "api.867678.xyz",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuckxter",
      "database_id": "56ac6d87-cc10-4b8c-85c9-6689ef074ad8",
      "migrations_dir": "worker/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_CACHE",
      "bucket_name": "fuckxter-r2",
    },
  ],
}
