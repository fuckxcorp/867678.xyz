{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "867678-xyz",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "867678.xyz/*",
      "zone_name": "867678.xyz",
    },
    {
      "pattern": "www.867678.xyz/*",
      "zone_name": "867678.xyz",
    },
  ],
}
